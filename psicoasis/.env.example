# ──────────────────────────────────────────────────────────────
# PsicoAsis — Variables de entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ──────────────────────────────────────────────────────────────

# Clave secreta de Django (genera una nueva para producción)
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# API de Claude / Anthropic (para el asistente PsicoIA)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Correo que ENVÍA los emails (cuenta Gmail de la institución)
PSICOASIS_EMAIL=psicoasis@colegio.edu.co
PSICOASIS_EMAIL_PASSWORD=contraseña_de_aplicacion_gmail

# Correo de la psicóloga que RECIBE las notificaciones de citas
PSICOLOGA_EMAIL=psicologa@colegio.edu.co

# ID del calendario de Google (opcional, para integración)
GOOGLE_CALENDAR_ID=psicologa@gmail.com
